<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">
  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="18dp">

    <TextView android:id="@+id/r1Back" android:layout_width="34dp" android:layout_height="30dp"
        android:text="‹" android:textSize="30sp" android:textColor="#007AFF"
        android:gravity="center_vertical" android:clickable="true" android:focusable="true"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="斐讯 R1" android:textSize="12sp" android:textColor="#8E8E93"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="音箱控制" android:textSize="24sp" android:textColor="#000000"
        android:layout_marginTop="2dp" android:layout_marginBottom="16dp"/>

    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/card"
        android:padding="14dp">
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:gravity="center_vertical">
        <View android:id="@+id/dot" android:layout_width="9dp" android:layout_height="9dp"
            android:background="#E24B4A"/>
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="检测中…"
            android:textSize="14sp" android:textColor="#000000" android:layout_marginStart="9dp"/>
        <TextView android:id="@+id/refreshBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="刷新"
            android:textSize="14sp" android:textColor="#007AFF"
            android:layout_marginStart="8dp" android:padding="4dp"
            android:clickable="true" android:focusable="true"/>
      </LinearLayout>
      <TextView android:id="@+id/infoText" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:text=""
          android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginTop="6dp"/>

      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:gravity="center_vertical"
          android:layout_marginTop="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="音量" android:textSize="13sp" android:textColor="#8E8E93"/>
        <TextView android:id="@+id/volumeText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="– / 15"
            android:textSize="34sp" android:textColor="#000000" android:layout_marginStart="12dp"/>
      </LinearLayout>
      <SeekBar android:id="@+id/seekBar" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:max="15" android:progress="6"
          android:layout_marginTop="8dp"/>
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <TextView android:id="@+id/v2" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="2" android:gravity="center"
            android:textSize="13sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/v4" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="4" android:gravity="center"
            android:textSize="13sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/v6" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="6" android:gravity="center"
            android:textSize="13sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/v8" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="8" android:gravity="center"
            android:textSize="13sp" android:textColor="#FFFFFF" android:background="@drawable/pill_active"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/v10" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="10" android:gravity="center"
            android:textSize="13sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginEnd="4dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/v12" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="12" android:gravity="center"
            android:textSize="13sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:clickable="true" android:focusable="true"/>
      </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="睡眠定时" android:textSize="12sp" android:textColor="#8E8E93"
        android:layout_marginTop="18dp" android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/card" android:padding="13dp">
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content">
        <TextView android:id="@+id/t15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="15 分钟" android:gravity="center"
            android:textSize="14sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/t30" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="30 分钟" android:gravity="center"
            android:textSize="14sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:layout_marginEnd="6dp" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/t60" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="60 分钟" android:gravity="center"
            android:textSize="14sp" android:textColor="#007AFF" android:background="@drawable/pill"
            android:paddingLeft="0dp" android:paddingRight="0dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:clickable="true" android:focusable="true"/>
      </LinearLayout>
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:gravity="center_vertical"
          android:layout_marginTop="10dp">
        <TextView android:id="@+id/timerStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="渐弱至静音"
            android:textSize="14sp" android:textColor="#8E8E93"/>
        <TextView android:id="@+id/timerCancel" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="取消" android:visibility="gone"
            android:textSize="14sp" android:textColor="#007AFF" android:layout_marginStart="14dp"
            android:clickable="true" android:focusable="true"/>
      </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="到点前 1 分钟音量逐渐降到 0"
        android:textSize="12sp" android:textColor="#8E8E93"
        android:layout_marginStart="4dp" android:layout_marginTop="5dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="休眠" android:textSize="12sp" android:textColor="#8E8E93"
        android:layout_marginTop="18dp" android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/card"
        android:padding="13dp" android:gravity="center_vertical">
      <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="静音休眠" android:textSize="14sp" android:textColor="#000000"/>
        <TextView android:id="@+id/sleepHint" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="关闭后恢复到原音量"
            android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginTop="2dp"/>
      </LinearLayout>
      <TextView android:id="@+id/sleepSwitch" android:layout_width="46dp" android:layout_height="27dp"
          android:background="@drawable/switch_off" android:gravity="center_vertical"
          android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="蓝牙" android:textSize="12sp" android:textColor="#8E8E93"
        android:layout_marginTop="18dp" android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/card" android:padding="13dp">
      <TextView android:id="@+id/btButton" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:text="打开蓝牙模式"
          android:gravity="center" android:textSize="15sp" android:textStyle="bold"
          android:textColor="#FFFFFF" android:background="@drawable/bt_button"
          android:paddingLeft="0dp" android:paddingRight="0dp"
          android:paddingTop="13dp" android:paddingBottom="13dp"
          android:clickable="true" android:focusable="true"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="等同于按三下音箱顶键，让音箱进入蓝牙模式" android:textSize="12sp"
          android:textColor="#8E8E93" android:layout_marginTop="8dp"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="音箱状态" android:textSize="12sp" android:textColor="#8E8E93"
        android:layout_marginTop="18dp" android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/card">
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="固件版本" android:textSize="14sp" android:textColor="#3C3C43"/>
        <TextView android:id="@+id/infoFw" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="–" android:textSize="14sp"
            android:textColor="#8E8E93" android:gravity="end"/>
      </LinearLayout>
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="WiFi 信号" android:textSize="14sp" android:textColor="#3C3C43"/>
        <TextView android:id="@+id/infoWifi" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="–" android:textSize="14sp"
            android:textColor="#8E8E93" android:gravity="end"/>
      </LinearLayout>
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="已开机" android:textSize="14sp" android:textColor="#3C3C43"/>
        <TextView android:id="@+id/infoUptime" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="–" android:textSize="14sp"
            android:textColor="#8E8E93" android:gravity="end"/>
      </LinearLayout>
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="蓝牙连接状态" android:textSize="14sp" android:textColor="#3C3C43"/>
        <TextView android:id="@+id/infoBt" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="–" android:textSize="14sp"
            android:textColor="#8E8E93" android:gravity="end"/>
      </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="音箱地址" android:textSize="12sp" android:textColor="#8E8E93"
        android:layout_marginTop="18dp" android:layout_marginStart="4dp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/card" android:padding="13dp">
      <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
          android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="IP" android:textSize="14sp" android:textColor="#3C3C43"/>
        <EditText android:id="@+id/ipEdit" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text=""
            android:textSize="14sp" android:textColor="#007AFF" android:background="@null"
            android:inputType="text" android:singleLine="true" android:gravity="end"
            android:layout_marginStart="8dp" android:padding="0dp"/>
        <TextView android:id="@+id/findBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="查找"
            android:textSize="14sp" android:textColor="#007AFF" android:layout_marginStart="12dp"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/saveBtn" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="保存"
            android:textSize="14sp" android:textColor="#007AFF" android:layout_marginStart="12dp"
            android:clickable="true" android:focusable="true"/>
      </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/findHint" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点「查找」可自动在局域网内定位音箱"
        android:textSize="11sp" android:textColor="#AEAEB2"
        android:layout_marginStart="4dp" android:layout_marginTop="6dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="手机直连音箱 · 电脑无需开机" android:textSize="11sp" android:textColor="#AEAEB2"
        android:layout_gravity="center_horizontal" android:layout_marginTop="20dp"/>
  </LinearLayout>
</ScrollView>
