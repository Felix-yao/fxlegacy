<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="0dp"
    android:layout_height="wrap_content" android:background="@drawable/card"
    android:gravity="center_horizontal" android:padding="12dp">

  <TextView android:id="@+id/plugName" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="插口" android:gravity="center"
      android:textSize="14sp" android:textStyle="bold" android:textColor="#000000"
      android:clickable="true" android:focusable="true"
      android:paddingTop="2dp" android:paddingBottom="2dp"/>

  <TextView android:id="@+id/plugSwitch" android:layout_width="46dp" android:layout_height="27dp"
      android:background="@drawable/switch_off" android:layout_marginTop="11dp"
      android:clickable="true" android:focusable="true"/>

  <TextView android:id="@+id/plugTimer" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:text="定时" android:gravity="center"
      android:textSize="12sp" android:textColor="#007AFF" android:background="@drawable/pill"
      android:paddingLeft="12dp" android:paddingRight="12dp"
      android:paddingTop="5dp" android:paddingBottom="5dp" android:layout_marginTop="11dp"
      android:clickable="true" android:focusable="true"/>
</LinearLayout>
