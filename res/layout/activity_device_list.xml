<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F7">
  <LinearLayout
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="18dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="FX遗产" android:textSize="12sp" android:textColor="#8E8E93"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="设备" android:textSize="28sp" android:textStyle="bold"
        android:textColor="#000000" android:layout_marginTop="2dp" android:layout_marginBottom="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="选择一个设备进行控制" android:textSize="13sp" android:textColor="#8E8E93"
        android:layout_marginBottom="20dp"/>

    <!-- R1 card -->
    <LinearLayout android:id="@+id/cardR1" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/card" android:padding="16dp"
        android:clickable="true" android:focusable="true">
      <LinearLayout android:layout_width="52dp" android:layout_height="52dp"
          android:background="@drawable/icon_r1" android:layout_marginEnd="14dp"/>
      <LinearLayout android:orientation="vertical" android:layout_width="0dp"
          android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="R1 音箱" android:textSize="17sp" android:textStyle="bold"
            android:textColor="#000000"/>
        <TextView android:id="@+id/r1Sub" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="音量 · 蓝牙 · 睡眠定时"
            android:textSize="13sp" android:textColor="#8E8E93" android:layout_marginTop="3dp"/>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="›" android:textSize="30sp" android:textColor="#C7C7CC"
          android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <!-- TC1 card -->
    <LinearLayout android:id="@+id/cardTc1" android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/card" android:padding="16dp"
        android:layout_marginTop="14dp"
        android:clickable="true" android:focusable="true">
      <LinearLayout android:layout_width="52dp" android:layout_height="52dp"
          android:background="@drawable/icon_tc1" android:layout_marginEnd="14dp"/>
      <LinearLayout android:orientation="vertical" android:layout_width="0dp"
          android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="TC1 排插" android:textSize="17sp" android:textStyle="bold"
            android:textColor="#000000"/>
        <TextView android:id="@+id/tc1Sub" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="6 路开关 · 功率 · 定时"
            android:textSize="13sp" android:textColor="#8E8E93" android:layout_marginTop="3dp"/>
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:text="›" android:textSize="30sp" android:textColor="#C7C7CC"
          android:layout_gravity="center_vertical"/>
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="手机直连设备 · 无需电脑" android:textSize="11sp" android:textColor="#AEAEB2"
        android:layout_marginTop="28dp"/>
  </LinearLayout>
</ScrollView>
