<?xml version="1.0" encoding="utf-8"?>
<!--
  设备默认地址 —— 通常不需要改。

  App 首次运行会自动在局域网内查找设备：
    - R1 音箱：扫描 5555 端口
    - TC1 排插：发 UDP 广播，设备会回报自己的 MAC

  只有当自动发现失败（比如路由器隔离了广播、设备在不同网段）时，
  才会用到下面这两个兜底值。可以换成你自己的设备信息后重新构建。

  - r1_ip  : R1 音箱的局域网 IP
  - tc1_mac: zTC1 排插的 MAC（小写、无冒号）
-->
<resources>
    <string name="r1_ip">192.168.1.100</string>
    <string name="tc1_mac">001122334455</string>
</resources>
